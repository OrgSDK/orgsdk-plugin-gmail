{
	"name": "@orgsdk/plugin-gmail",
	"version": "1.0.8",
	"description": "Gmail integration (restricted scope, BYO only) \u2014 search, threads, labels, attachments, send, reply. Shares the google-oauth credential with google-sheets/google-tasks but rejects first-party tokens.",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"validate": "orgsdk-plugin validate",
		"package": "orgsdk-plugin package",
		"version-guard": "orgsdk-plugin version-guard",
		"build": "bun run typecheck && bun run validate && bun run package",
		"publish:catalog": "orgsdk-plugin publish",
		"build:npm": "node scripts/build-npm.mjs",
		"test:executor": "node scripts/test-executor.mjs",
		"pack:npm": "npm pack ./dist/npm --ignore-scripts",
		"test:registration": "node scripts/test-registration.mjs"
	},
	"dependencies": {
		"@googleapis/gmail": "22.0.2",
		"google-auth-library": "11.3.2",
		"turndown": "^7.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@orgsdk/plugins": "0.2.2",
		"@types/bun": "^1.3.9",
		"@types/turndown": "^5.0.5",
		"typescript": "~6.0.3",
		"@orgsdk/executor": "0.1.0",
		"nock": "15.0.5"
	},
	"overrides": {
		"zod": "4.6.7",
		"qs": "6.17.1"
	},
	"patchedDependencies": {
		"@orgsdk/executor@0.1.0": "patches/@orgsdk%2Fexecutor@0.1.0.patch"
	},
	"license": "Apache-2.0",
	"author": "OrgSDK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OrgSDK/orgsdk-plugin-gmail.git"
	},
	"bugs": {
		"url": "https://github.com/OrgSDK/orgsdk-plugin-gmail/issues"
	},
	"homepage": "https://github.com/OrgSDK/orgsdk-plugin-gmail#readme"
}
